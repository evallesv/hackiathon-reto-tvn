# ==============================================================================
# HackIAthon TVN Media - Environment Configuration
# De la señal a la decisión: Copiloto de inteligencia informativa con IA
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# ------------------------------------------------------------------------------
# Decision Models (System One: jev | cloudflare | mock)
# Dedicated non-generative classification & decision models
# Default: jev (hosted on OpenCode Zen, uses OPENCODE_API_KEY)
# ------------------------------------------------------------------------------
DECISION_PROVIDER=jev
DECISION_CONCURRENCY_LIMIT=5

# TypeSafe Jev Settings (System One via OpenCode Zen or TypeSafe)
# If TYPESAFE_API_KEY is not set, the system automatically uses OPENCODE_API_KEY.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://opencode.ai/zen/v1/systemone
TYPESAFE_MODEL=jev-1.13-free
TYPESAFE_TIMEOUT_SECONDS=30.0

# Cloudflare Clef Settings (Alternative Workers AI Decision Model)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_api_token_here
CLOUDFLARE_DECISION_MODEL=@cf/cloudflare/clef
CLOUDFLARE_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# LLM Providers Configuration (Generative System Two: opencode | gemini | mock)
# ------------------------------------------------------------------------------
# Default provider per challenge requirements: opencode (OpenCode Go)
LLM_PROVIDER=opencode

# OpenCode Configuration (Shares OPENCODE_API_KEY with Jev)
# Model options in Go: muse-spark-1.3-contributor, qwen3.8-flash, etc.
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=muse-spark-1.3-contributor
OPENCODE_TIMEOUT_SECONDS=45.0

# Google Gemini Configuration (Alternative connector)
# Model options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45.0

# ------------------------------------------------------------------------------
# Storage & Data Paths
# ------------------------------------------------------------------------------
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
BENCHMARK_PATH=data/benchmark.jsonl
MANIFEST_PATH=data/manifest.json

# SQLite Persistent Database & Scheduled Ingestion (Fly.io volume: /data/copilot.db)
SQLITE_DB_PATH=data/storage/copilot.db
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
LIVE_AGENDA_MAX_AGE_HOURS=72

# ------------------------------------------------------------------------------
# Notion Business Integration (Optional automation / sync)
# ------------------------------------------------------------------------------
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here
NOTION_PAGE_INICIO_ID=
NOTION_PAGE_EVIDENCIAS_ID=

# ------------------------------------------------------------------------------
# Security & Safety Guards
# ------------------------------------------------------------------------------
STRICT_CITATION_VERIFICATION=true
PROMPT_INJECTION_SHIELD_ENABLED=true
MAX_SUMMARY_WORDS_TVN_BRIEF=250
MAX_WORDS_TVN_DIGITAL_COPY=80
SCRIPT_DURATION_SECONDS_MIN=45
SCRIPT_DURATION_SECONDS_MAX=60
